include ../data/index.pug
include ../mixins/index.pug

doctype html
html(lang="en")
  head
    block meta
      meta(charset="UTF-8")
      meta(name="viewport" content="width=device-width, initial-scale=1.0")
    block title
      title Keepsake - Digital & Branding Agency
    block styles
      link(rel="preconnect" href="https://fonts.googleapis.com")
      link(rel="preconnect" href="https://fonts.gstatic.com" crossorigin)
      link(href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@700&family=Open+Sans:wght@300;400;700&family=Oswald:wght@300;400;700&display=swap" rel="stylesheet")
      link(rel="stylesheet" href="../styles/main.scss")
  body#top
    include ../components/header.pug
    main
      block content
    include ../components/footer.pug
    a.back-to-top(href="#top" aria-label="Back to top")
      svg(viewBox="0 0 24 24" width="20" height="20" fill="#fff")
        path(d="M12 4l-8 8h6v8h4v-8h6z")
    block scripts
      script(type="module" src="../../main.js")
