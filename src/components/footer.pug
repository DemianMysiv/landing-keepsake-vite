footer#contact.footer
  .container
    .footer-top
      .footer-links
        .link-column
          h4 STUDIO
          ul
            each link in footerLinksStudio
              li: a(href=link.href) #{link.text}
        .link-column
          h4 SERVICES
          ul
            each link in footerLinksServices
              li: a(href=link.href) #{link.text}
      .footer-newsletter
        h4 NEWSLETTER
        p Fresh case studies and design notes, once a month.
        form.newsletter-form(action="#newsletter-success" method="get")
          label.visually-hidden(for="email") Your email address
          .input-group
            input#email(type="email" placeholder="Your email address" required aria-describedby="email-error")
            button.btn.btn-primary(type="submit") SUBSCRIBE
          span#email-error.error-text(role="alert") Please enter a valid email address.
          .checkbox-wrapper
            input#privacy(type="checkbox" required)
            label(for="privacy") I agree to the privacy policy
        p#newsletter-success.success-text(role="status") Thank you! Your subscription request has been accepted (demo).
    .footer-bottom
      p &copy; 2026 Keepsake. All rights reserved.
      .socials
        each social in socialLinks
          a.social-link(href="#" class=social.class aria-label=social.label) #{social.text}
