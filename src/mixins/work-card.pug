mixin work-card(work)
  article.card(data-category=work.category)
    img(src=`images/${work.image}.webp` alt=work.title loading="lazy" width="350" height="276")
    .card-overlay(tabindex="0" role="group" aria-label="Project information")
      span.btn-teal-plus(aria-hidden="true") +
      h3 #{work.title}
      .accent-line
      span.card-category #{work.category.charAt(0).toUpperCase() + work.category.slice(1)}
