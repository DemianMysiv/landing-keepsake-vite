mixin icon(name)
  case name
    when 'web-design'
      svg(viewBox="0 0 48 48" width="34" height="34" aria-hidden="true")
        rect(x="8" y="12" width="32" height="24" rx="2" fill="#A9B7BA")
        rect(x="12" y="16" width="24" height="16" fill="#E6ECEE")
        rect(x="15" y="19" width="18" height="10" fill="#80CBA4")
        rect(x="15" y="19" width="18" height="3" fill="#E2E6E6")
    when 'motion'
      svg(viewBox="0 0 48 48" width="34" height="34" aria-hidden="true")
        rect(x="7" y="11" width="34" height="26" rx="3" fill="#607B88")
        rect(x="11" y="15" width="26" height="18" rx="1" fill="#B5D3DE")
    when 'print'
      svg(viewBox="0 0 48 48" width="34" height="34" aria-hidden="true")
        rect(x="14" y="7" width="20" height="16" rx="1" fill="#E4E4E1")
        rect(x="9" y="20" width="30" height="18" rx="2" fill="#9BA5A7")
        rect(x="14" y="28" width="20" height="12" fill="#EAC75D")
        circle(cx="34" cy="24" r="1.4" fill="#E1F0EA")
    when 'illustration'
      svg(viewBox="0 0 48 48" width="34" height="34" aria-hidden="true")
        path(d="M24 39 10 25C3 18 9 8 17 10c3 0 5 2 7 5 2-3 4-5 7-5 8-2 14 8 7 15Z" fill="#F95858")
